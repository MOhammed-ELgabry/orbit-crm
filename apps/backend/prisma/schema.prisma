generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id String @id @default(cuid())

  // Company Information
  name         String
  contactEmail String?
  phone        String?
  address      String?
  logo         String?
  website      String?
  taxNumber    String?
  description  String?

  // Onboarding
  // Set via the post-verification "Business Type Selection" step (see
  // OnboardingToken below). Nullable because a company exists before this
  // step runs — it's populated once this step runs.
  businessType String?

  // Status
  isActive Boolean @default(true)

  // Relations
  users            User[]
  roles            Role[]
  contacts         Contact[]
  onboardingTokens OnboardingToken[]
  activities       Activity[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([deletedAt])
}

model User {
  id String @id @default(cuid())

  // Personal Information
  firstName String
  lastName  String

  // Authentication
  email        String  @unique
  passwordHash String?

  // Authentication Provider
  provider   String @default("local")
  providerId String?

  // Email Verification
  isEmailVerified       Boolean   @default(false)
  emailVerificationCode String?
  emailVerificationExpires DateTime?

  // Refresh Token
  refreshTokenHash String?

  // Profile
  phone  String?
  avatar String?

  // Status
  isActive Boolean @default(true)
  isOwner  Boolean @default(false)

  // Tracking
  lastLoginAt DateTime?

  // Company
  // Optional during registration.
  // The company is created and assigned after email verification.
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id])
  pendingCompanyName String?

  // RBAC
  roleId String?
  role   Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Sessions & Password Reset
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]

  // Social Authentication
  socialAccounts SocialAccount[]

  // Contacts
  contactsCreated  Contact[] @relation("ContactCreatedBy")
  contactsAssigned Contact[] @relation("ContactAssignedTo")

  // Activities
  activitiesCreated Activity[] @relation("ActivityCreatedBy")

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([roleId])
  @@index([deletedAt])
  @@index([isEmailVerified])
  @@index([provider])
  @@index([providerId])
}

// Links an OAuth/OIDC provider identity (Google, Facebook, Microsoft) to an
// existing Orbit CRM User.
model SocialAccount {
  id String @id @default(cuid())

  provider          String
  providerAccountId String

  email String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerification {
  id String @id @default(cuid())

  email String @unique
  code  String

  expiresAt  DateTime
  verifiedAt DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Single-purpose, single-use ticket that lets the Business Type Selection
// step persist to the correct Company in the window between Email
// Verification and Login.
model OnboardingToken {
  id        String    @id @default(cuid())
  companyId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
}

model Role {
  id          String  @id @default(cuid())
  name        String
  description String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Contact {
  id String @id @default(cuid())

  // Tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Personal Information
  firstName String
  lastName  String

  // Contact Information
  email  String?
  phone  String?
  mobile String?

  // Business Information
  jobTitle         String?
  organizationName String?
  website          String?

  // Address
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  // CRM Information
  notes  String?
  source String?
  status String @default("active")

  // Ownership / Assignment
  createdById String
  createdBy   User @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User? @relation("ContactAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Activities
  activities Activity[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([deletedAt])
}

// A single chronological CRM event such as a note, call, email, or meeting.
// Every activity belongs to exactly one tenant company and may optionally
// be linked to one Contact.
model Activity {
  id String @id @default(cuid())

  // Tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Classification
  type String

  // Content
  title       String
  description String?

  // When the activity actually happened
  occurredAt DateTime @default(now())

  // User who performed/logged the activity
  createdById String
  createdBy   User @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Optional Contact association
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, occurredAt])
  @@index([companyId, type])
  @@index([companyId, contactId])
  @@index([createdById])
  @@index([contactId])
  @@index([deletedAt])
}

