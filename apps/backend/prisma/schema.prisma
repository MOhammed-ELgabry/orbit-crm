generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id String @id @default(cuid())

  // Company Information
  name         String
  contactEmail String?
  phone        String?
  address      String?
  logo         String?
  website      String?
  taxNumber    String?
  description  String?

  // Onboarding
  // Set via the post-verification "Business Type Selection" step (see
  // OnboardingToken below). Nullable because a company exists before this
  // step runs — it's populated once this step runs.
  businessType String?

  // Status
  isActive Boolean @default(true)

  // Relations
  users            User[]
  roles            Role[]
  contacts         Contact[]
  leads            Lead[]
  deals            Deal[]
  tasks            Task[]
  onboardingTokens OnboardingToken[]
  activities       Activity[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([deletedAt])
}

model User {
  id String @id @default(cuid())

  // Personal Information
  firstName String
  lastName  String

  // Authentication
  email        String  @unique
  passwordHash String?

  // Authentication Provider
  provider   String  @default("local")
  providerId String?

  // Email Verification
  isEmailVerified          Boolean   @default(false)
  emailVerificationCode    String?
  emailVerificationExpires DateTime?

  // Refresh Token
  refreshTokenHash String?

  // Profile
  phone  String?
  avatar String?

  // Settings
  // language: interface language preference ("ar" | "en"), validated at
  // the DTO layer (UpdateUserLanguageDto) — see LANGUAGES in
  // user/constants/language.constants.ts. Defaults to "en" to match the
  // frontend's i18next fallbackLng, so every existing row already has a
  // valid value with no backfill required.
  // backgroundColor: user-chosen background color for the main content
  // canvas (hex string, e.g. "#F6F8FC"). Nullable — null means "no
  // custom preference, use the application's built-in default" rather
  // than freezing one default into every row. The matching foreground
  // text color is intentionally never stored: it's derived
  // deterministically from this value at render time (WCAG contrast),
  // so it can never drift out of sync with it.
  language        String  @default("en")
  backgroundColor String?

  // Status
  isActive Boolean @default(true)
  isOwner  Boolean @default(false)

  // Tracking
  lastLoginAt DateTime?

  // Company
  // Optional during registration.
  // The company is created and assigned after email verification.
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id])
  pendingCompanyName String?

  // RBAC
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Sessions & Password Reset
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]

  // Social Authentication
  socialAccounts SocialAccount[]

  // Contacts
  contactsCreated  Contact[] @relation("ContactCreatedBy")
  contactsAssigned Contact[] @relation("ContactAssignedTo")

  // Leads
  leadsCreated  Lead[] @relation("LeadCreatedBy")
  leadsAssigned Lead[] @relation("LeadAssignedTo")

  // Deals
  dealsCreated  Deal[] @relation("DealCreatedBy")
  dealsAssigned Deal[] @relation("DealAssignedTo")

  // Tasks
  tasksCreated  Task[] @relation("TaskCreatedBy")
  tasksAssigned Task[] @relation("TaskAssignedTo")

  // Activities
  activitiesCreated Activity[] @relation("ActivityCreatedBy")

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([roleId])
  @@index([deletedAt])
  @@index([isEmailVerified])
  @@index([provider])
  @@index([providerId])
}

// Links an OAuth/OIDC provider identity (Google, Facebook, Microsoft) to an
// existing Orbit CRM User.
model SocialAccount {
  id String @id @default(cuid())

  provider          String
  providerAccountId String

  email String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerification {
  id String @id @default(cuid())

  email String @unique
  code  String

  expiresAt  DateTime
  verifiedAt DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Single-purpose, single-use ticket that lets the Business Type Selection
// step persist to the correct Company in the window between Email
// Verification and Login.
model OnboardingToken {
  id        String    @id @default(cuid())
  companyId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
}

model Role {
  id          String  @id @default(cuid())
  name        String
  description String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Contact {
  id String @id @default(cuid())

  // Tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Personal Information
  firstName String
  lastName  String

  // Contact Information
  email  String?
  phone  String?
  mobile String?

  // Business Information
  jobTitle         String?
  organizationName String?
  website          String?

  // Address
  address    String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  // CRM Information
  notes  String?
  source String?
  status String  @default("active")

  // Ownership / Assignment
  createdById String
  createdBy   User   @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("ContactAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Activities
  activities Activity[]

  // Deals
  deals Deal[]

  // Tasks
  tasks Task[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([deletedAt])
}

// An unqualified prospective inquiry, tracked separately from Contact.
// Deliberately has no conversion link to Contact yet — that's future
// work, intentionally not implemented here (see the Leads spec this
// model was built against). Every lead belongs to exactly one tenant
// company.
model Lead {
  id String @id @default(cuid())

  // Tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Personal Information
  firstName String
  lastName  String

  // Contact Information
  email String?
  phone String?

  // Business Information
  organizationName String?

  // CRM Information
  source String?
  status String  @default("new")
  notes  String?

  // Ownership / Assignment
  createdById String
  createdBy   User   @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Deals
  deals Deal[]

  // Tasks
  tasks Task[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([deletedAt])
}

// A single chronological CRM event such as a note, call, email, or meeting.
// Every activity belongs to exactly one tenant company and may optionally
// be linked to one Contact.
model Activity {
  id String @id @default(cuid())

  // Tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Classification
  type String

  // Content
  title       String
  description String?

  // When the activity actually happened
  occurredAt DateTime @default(now())

  // User who performed/logged the activity
  createdById String
  createdBy   User   @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Optional Contact association
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Optional Deal association — added alongside the Deal model so a
  // deal's lifecycle events (see DealService) have somewhere to live,
  // mirroring the Contact association above exactly. 'SYSTEM' and
  // 'STATUS_CHANGE' already existed in ACTIVITY_TYPES before Deal did —
  // this reuses that existing vocabulary rather than adding a new one.
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // Optional Task association — added alongside the Task model for the
  // same reason as the Deal association above: a task's lifecycle
  // events (see TaskService) need somewhere to live. Reuses the
  // existing 'SYSTEM'/'STATUS_CHANGE' vocabulary, not the separate
  // pre-existing 'TASK' ACTIVITY_TYPES value — that value is an
  // unrelated, manually-chosen activity *kind* (like 'CALL'/'EMAIL')
  // a user can pick when logging a generic activity, not reserved for
  // this model.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, occurredAt])
  @@index([companyId, type])
  @@index([companyId, contactId])
  @@index([companyId, dealId])
  @@index([companyId, taskId])
  @@index([createdById])
  @@index([contactId])
  @@index([dealId])
  @@index([taskId])
  @@index([deletedAt])
}

// A sales opportunity, optionally linked to a Contact and/or a Lead.
// Both links are independent and nullable — creating a Deal never
// requires converting a Lead into a Contact first, and this schema
// deliberately doesn't implement Lead -> Contact conversion (see the
// comment on Lead above for why); a Deal may reference either, both, or
// neither. Every deal belongs to exactly one tenant company.
//
// stage doubles as the outcome (CLOSED_WON/CLOSED_LOST are stages, not
// a separate status field) — the same one-field-per-lifecycle choice
// already made for Lead.status/Contact.status, and it avoids a second
// field that could contradict the first (e.g. stage: negotiation but
// status: closed_lost). See DEAL_STAGES (deal/constants/deal.constants.ts)
// for the actual whitelist, enforced at the application layer exactly
// like LEAD_STATUSES/CONTACT_STATUSES — adjusting it never requires a
// migration.
//
// No currency field: nothing else in this schema has a monetary/
// currency concept yet (no Company-level currency, no conversion
// logic), so amount is a plain, single-currency Decimal rather than a
// half-built multi-currency system with no display or conversion logic
// anywhere to back it.
model Deal {
  id String @id @default(cuid())

  // Tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Core Information
  title  String
  amount Decimal @default(0) @db.Decimal(12, 2)

  // CRM Information
  stage             String    @default("new")
  notes             String?
  expectedCloseDate DateTime?

  // Associations — independent and optional, see model comment above
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Ownership / Assignment
  createdById String
  createdBy   User   @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("DealAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Activities
  activities Activity[]

  // Tasks
  tasks Task[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, stage])
  @@index([companyId, assignedToId])
  @@index([companyId, contactId])
  @@index([companyId, expectedCloseDate])
  @@index([createdById])
  @@index([assignedToId])
  @@index([contactId])
  @@index([leadId])
  @@index([deletedAt])
}

// A CRM to-do item: something a person needs to do, optionally in the
// context of a Contact, a Lead, and/or a Deal (all three independent
// and optional, exactly like Deal's own contactId/leadId — see the
// comment on Deal above for why unrelated-and-nullable is the right
// shape here too; a Task may stand alone, or be linked to any subset
// of the three). Every task belongs to exactly one tenant company.
//
// status doubles as the lifecycle outcome (COMPLETED/CANCELLED are
// statuses, not a separate boolean "done" flag) — the same
// one-field-per-lifecycle choice already made for Lead.status/
// Contact.status/Deal.stage. See TASK_STATUSES
// (task/constants/task.constants.ts) for the whitelist, enforced at
// the application layer exactly like DEAL_STAGES — adjusting it never
// requires a migration. Same treatment for TASK_PRIORITIES.
//
// completedAt is deliberately not client-writable (see CreateTaskDto/
// UpdateTaskDto — it isn't a field on either): TaskService derives it
// from `status` on every write, so it can never contradict `status`
// the way two independently-editable fields could.
//
// Designed so Calendar/Notifications/Automations (all explicitly out
// of scope for this phase — see the Tasks Phase 1 spec) can be built
// against this model later without a redesign: dueDate is a plain
// DateTime a future Calendar can read directly, and status/priority
// are already whitelisted, filterable strings a future Automation
// engine can key off (e.g. a `task.status_changed` event) with no
// schema change.
model Task {
  id String @id @default(cuid())

  // Tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Core Information
  title       String
  description String?

  // CRM Information
  status   String    @default("todo")
  priority String    @default("medium")
  dueDate  DateTime?

  // When the task was marked completed. Null unless status ==
  // "completed" — see the model comment above for why this is
  // service-derived rather than independently writable.
  completedAt DateTime?

  // Associations — independent and optional, see model comment above
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // Ownership / Assignment
  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Activities
  activities Activity[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@index([companyId, dueDate])
  @@index([companyId, contactId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([deletedAt])
}