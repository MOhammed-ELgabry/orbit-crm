generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id String @id @default(cuid())

  // Company Information
  name         String
  contactEmail String?
  phone        String?
  address      String?
  logo         String?
  website      String?
  taxNumber    String?
  description  String?

  // Status
  isActive Boolean @default(true)

  // Relations
  users User[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([deletedAt])
}

model User {
  id String @id @default(cuid())

  // Personal Information
  firstName String
  lastName  String

  // Authentication
  email        String @unique
  passwordHash String?

  // Authentication Provider
  provider   String @default("local")
  providerId String?

  // Email Verification
  isEmailVerified          Boolean   @default(false)
  emailVerificationCode    String?
  emailVerificationExpires DateTime?

  // Password Reset
  passwordResetCode    String?
  passwordResetExpires DateTime?

  // Refresh Token
  refreshTokenHash String?

  // Profile
  phone  String?
  avatar String?

  // Status
  isActive Boolean @default(true)
  isOwner  Boolean @default(false)

  // Tracking
  lastLoginAt DateTime?

  // Relations
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
authSessions AuthSession[]
  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([deletedAt])
  @@index([isEmailVerified])
  @@index([provider])
  @@index([providerId])
}

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}
model EmailVerification {
  id String @id @default(cuid())

  email String @unique
  code  String

  expiresAt DateTime
  verifiedAt DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}