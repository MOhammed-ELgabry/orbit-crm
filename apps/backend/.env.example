# =====================================================================
# Orbit CRM backend - LOCAL DEVELOPMENT ONLY (documentation template)
#
# The real file is apps/backend/.env.
# scripts/setup-local.ps1 can create it when it is missing and never
# overwrites an existing file.
#
# Never put production values here.
# Never commit apps/backend/.env.
# =====================================================================

NODE_ENV=development
PORT=3000

# Local PostgreSQL:
# role: postgres
# database: orbitcrm
# schema: public
#
# If the password contains special characters, percent-encode them.
# Example: @ becomes %40.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/orbitcrm?schema=public

# Use two DIFFERENT random values locally.
# 32+ characters recommended.
JWT_ACCESS_SECRET=GENERATE_LOCAL_ACCESS_SECRET
JWT_REFRESH_SECRET=GENERATE_LOCAL_REFRESH_SECRET

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Mailpit — local SMTP catcher.
# Emails stay local and are not delivered to real inboxes.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=local
MAIL_PASSWORD=local
MAIL_FROM=Orbit CRM Local <no-reply@orbit.local>

# Frontend origin used by the local backend.
# This must match the browser address exactly.
FRONTEND_URL=http://localhost:5173

# =====================================================================
# Social Authentication — OPTIONAL
#
# Leave these variables unset to disable the corresponding provider.
# Email/password authentication works without social authentication.
# =====================================================================

SOCIAL_AUTH_STATE_SECRET=GENERATE_LOCAL_SOCIAL_AUTH_STATE_SECRET

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=

# =====================================================================
# Optional local monitoring / analytics
#
# Normally left unset during local development.
# =====================================================================

# SENTRY_DSN=
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=

