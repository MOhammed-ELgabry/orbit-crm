# =====================================================================
# Orbit CRM backend - LOCAL DEVELOPMENT ONLY (documentation template)
#
# The real file is apps/backend/.env.
# scripts/setup-local.ps1 can create it when it is missing and never
# overwrites an existing file.
#
# Never put production values here.
# Never commit apps/backend/.env.
# =====================================================================

NODE_ENV=development
PORT=3000

# Local PostgreSQL:
# role: postgres
# database: orbitcrm
# schema: public
#
# If the password contains special characters, percent-encode them.
# Example: @ becomes %40.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/orbitcrm?schema=public

# Use two DIFFERENT random values locally.
# 32+ characters recommended.
JWT_ACCESS_SECRET=GENERATE_LOCAL_ACCESS_SECRET
JWT_REFRESH_SECRET=GENERATE_LOCAL_REFRESH_SECRET

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Mailpit — local SMTP catcher.
# Emails stay local and are not delivered to real inboxes.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=local
MAIL_PASSWORD=local
MAIL_FROM=Orbit CRM Local <no-reply@orbit.local>

# Frontend origin used by the local backend.
# This must match the browser address exactly.
FRONTEND_URL=http://localhost:5173

# =====================================================================
# Social Authentication — OPTIONAL
#
# Leave these variables unset to disable the corresponding provider.
# Email/password authentication works without social authentication.
# =====================================================================

SOCIAL_AUTH_STATE_SECRET=GENERATE_LOCAL_SOCIAL_AUTH_STATE_SECRET

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=

# =====================================================================
# Optional local monitoring / analytics
#
# Normally left unset during local development.
# =====================================================================

# SENTRY_DSN=
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=

# =====================================================================
# Team Chat notifications (optional)
#
# Chat messages always create in-app (bell) notifications. Web Push for
# DIRECT chats is OFF unless CHAT_PUSH_ENABLED is exactly "true"; it also
# needs the existing VAPID/push configuration. Chat never sends email.
# =====================================================================

# CHAT_PUSH_ENABLED=false
# Delay before a chat push is sent (skipped if the user read it meanwhile).
# Default 45000 ms, capped at 600000 ms.
# CHAT_PUSH_DELAY_MS=45000

# =====================================================================
# Chat attachments (DIRECT conversations only) - OFF by default
#
# Master switch: the feature is ON only when CHAT_ATTACHMENTS_ENABLED is
# exactly "true". When on it is available to EVERY company (there is no
# company allow-list / block-list and no dependence on business type).
# A wrong value below keeps the feature OFF and never stops the app.
#
# Before turning it on:
#  - apply migration 20261030120000_add_chat_attachments;
#  - create the storage directory yourself, outside the repository, the
#    frontend build and any web-server public root, owned by the app user
#    with restricted permissions (e.g. 0700). The app never creates it;
#  - files are stored on local disk WITHOUT encryption at rest. Do not use
#    this feature for real patient / sensitive medical data.
# =====================================================================

CHAT_ATTACHMENTS_ENABLED=false
# Absolute path (default shown). Must already exist.
# CHAT_ATTACHMENTS_DIR=/var/lib/orbit-crm/chat-attachments
# Per-file limits (cannot exceed 5 MiB image / 10 MiB PDF).
# CHAT_ATTACHMENTS_IMAGE_MAX_BYTES=5242880
# CHAT_ATTACHMENTS_PDF_MAX_BYTES=10485760
# Per-user limits.
# CHAT_ATTACHMENTS_MAX_PENDING_PER_USER=3
# CHAT_ATTACHMENTS_MAX_DAILY_PER_USER=30
# Storage quota per company (bytes, default 500 MiB) and for all companies (default 2 GiB).
# CHAT_ATTACHMENTS_COMPANY_QUOTA_BYTES=524288000
# CHAT_ATTACHMENTS_GLOBAL_QUOTA_BYTES=2147483648
# Uploads are refused when the disk has less free space than this.
# CHAT_ATTACHMENTS_MIN_FREE_BYTES=1073741824
# Image dimension / pixel limits.
# CHAT_ATTACHMENTS_MAX_IMAGE_DIMENSION=10000
# CHAT_ATTACHMENTS_MAX_IMAGE_PIXELS=40000000
# Simultaneous uploads handled by one API process.
# CHAT_ATTACHMENTS_MAX_CONCURRENT_UPLOADS=4
# How long an unsent upload stays valid (ms).
# CHAT_ATTACHMENTS_UPLOADING_TTL_MS=900000
# CHAT_ATTACHMENTS_READY_TTL_MS=7200000
# In-process cleanup of unsent uploads. 0 disables the timer.
# CHAT_ATTACHMENTS_SWEEP_INTERVAL_MS=300000
# CHAT_ATTACHMENTS_SWEEP_BATCH_SIZE=200
